# Пример конфигурации без секретов (COST-18). Скопируйте в .env.local и заполните.
# URL проекта Supabase и publishable (или legacy anon) ключ — публичные значения, безопасны в браузере при включённом RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Подкаталог GitHub Pages: /<имя-репозитория>/ ; для локального запуска — /
VITE_BASE_PATH=/
# Метка окружения в интерфейсе: demo | staging | production
VITE_APP_ENV=demo

# Только для scripts/seed-users.mjs на компьютере администратора. НИКОГДА не в VITE_* и не в репозитории.
# SUPABASE_SECRET_KEY=sb_secret_...
